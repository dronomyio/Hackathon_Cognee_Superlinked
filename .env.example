SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_MODEL=zai-org/GLM-5.3-Flash:relay
SIE_MAX_OUTPUT_TOKENS=24576
KEENABLE_API_KEY=
BAND_API_KEY=
BAND_AGENT_ID=584e2271-9b94-4c5e-a0ff-3eee6aeea1f4
BAND_HANDLE=suvasis/superlinked-bot
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
# Cognee Cloud: API key must be supplied privately in .env.
COGNEE_URL=https://tenant-08778ee6-4489-4c05-9e04-f423294d0dec.aws.cognee.ai
COGNEE_TENANT_ID=08778ee6-4489-4c05-9e04-f423294d0dec
COGNEE_DATASET=forgeclaw-mesh
COGNEE_API_KEY=
# Optional bearer token for self-hosted deployments only.
COGNEE_API_TOKEN=

# Automatic discovery; slow runs skip elapsed ticks without overlapping.
NEWS_CHECK_INTERVAL_SECONDS=300

# Highest-priority keyword first; takes precedence over news_priorities.json.
# An empty value disables keyword scoring.
KEYWORDS=

SIE_DECISION_MODEL=fastino/GLiNER2.5-Decide
NEWS_DECISION_LIMIT=10

# Stock-swarm schedule; price/company-news collection cache lasts 15 minutes.
STOCK_CHECK_INTERVAL_SECONDS=300
